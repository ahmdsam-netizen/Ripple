{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "server.ts",
    "chatHandler.ts",
    "redisClient.ts",
    "server/**/*.ts",
    "socket/**/*.ts",
    "lib/**/*.ts",
    "generated/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
